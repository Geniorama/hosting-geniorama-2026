# ── PaymentsWay credentials ──────────────────────────────────
# Console: https://merchant.paymentsway.co/  → "Mis Credenciales"
PAYMENTSWAY_MERCHANT_ID=
PAYMENTSWAY_FORM_ID=
PAYMENTSWAY_TERMINAL_ID=
PAYMENTSWAY_API_KEY=

# ── Wompi credentials ────────────────────────────────────────
# Dashboard → Desarrolladores → "Secretos para integración técnica".
# - Public key (pub_prod_* / pub_test_*) — visible en frontend.
# - Integrity secret (prod_integrity_*) — server-only, firma redirect.
# - Events secret (prod_events_*) — server-only, valida webhooks.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ── App ──────────────────────────────────────────────────────
# Public base URL where the app is deployed (used to build response_url
# and the webhook target). Localhost example for dev:
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Asesor de IA (OpenAI) ────────────────────────────────────
# Alimenta el asesor (/api/advisor): recomienda uno de los planes de
# src/lib/plans.ts según lo que cuente el visitante. Aparece en dos lugares:
# la sección "Asesor IA" del home y la landing de campaña /asesor, que además
# captura leads (tabla `leads`, migración 0011, + aviso a MAIL_OPS_ALERT).
# Key en https://platform.openai.com/api-keys — server-only, nunca NEXT_PUBLIC_.
# Si la dejas vacía la sección sigue visible pero responde que el asesor no está
# habilitado; el resto del sitio no se afecta.
OPENAI_API_KEY=
# Opcional. Debe soportar Structured Outputs (response_format json_schema).
# Default: gpt-4.1-mini
OPENAI_MODEL=

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API. Service role key is server-only — never ship to
# the client. Run supabase/migrations/0001_orders.sql before first use.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Reseller primario: cPanel / WHM ──────────────────────────
# WHM → Manage API Tokens. WHM_API_URL incluye el puerto (:2087).
WHM_API_URL=
WHM_API_USER=
WHM_API_TOKEN=
WHM_DEFAULT_PACKAGE=
# Nameservers que se le envían al cliente en el correo de credenciales.
HOSTING_NS1=
HOSTING_NS2=

# ── Reseller secundario: Plesk (otro proveedor) ───────────────
# Se usa como fallback cuando el reseller de WHM se llena. Si estas variables
# están vacías el comportamiento es idéntico al de antes: falla → alerta manual.
#
# Antes de activarlo corre GET /api/admin/plesk-check (Bearer RESCUE_SECRET):
# te dice si las credenciales autentican y si puedes usar el modo "cli".
PLESK_API_URL=
# API key del panel (Plesk → Tools & Settings → API Keys). Alternativa: usuario
# y contraseña del reseller.
PLESK_API_KEY=
PLESK_API_USER=
PLESK_API_PASSWORD=
# "cli"  → POST /api/v2/cli/subscription/call (más completo, suele pedir admin)
# "rest" → POST /api/v2/clients + /api/v2/domains (permisos de reseller)
PLESK_PROVISION_MODE=cli
# Nombre EXACTO del service plan en Plesk que se le asigna a la suscripción.
PLESK_SERVICE_PLAN=
# Login del reseller dueño de la suscripción (sólo modo "cli").
PLESK_OWNER=
# IP a asignar y a mostrarle al cliente (opcional).
PLESK_IP=
# Nameservers y URL del panel de ESTE proveedor — son distintos a los de WHM.
PLESK_NS1=
PLESK_NS2=
# Hostname del servidor Plesk, ej. https://srv1.proveedor.com:8443. Si se define,
# el correo usa esta URL (cert válido, funciona antes de propagar el DNS) en vez
# de https://<dominio>:8443.
PLESK_PANEL_URL=
# Plesk en :8443 suele traer certificado autofirmado y Node rechaza la conexión.
# Ponlo en "true" sólo si el proveedor no tiene un certificado válido.
PLESK_ALLOW_SELF_SIGNED=

# ── Fallback de aprovisionamiento ────────────────────────────
# "manual" (default) → NO llama al API de Plesk. Cuando WHM se llena le manda al
#                      equipo un correo con los datos y el comando de
#                      /api/admin/complete-order para crear la cuenta a mano en
#                      Plesk. Es el modo vigente mientras se resuelve el API.
# "capacity"         → crea la cuenta en Plesk automáticamente cuando WHM se llena
# "any"              → automático ante cualquier error salvo conflictos
# "off"              → nunca menciona Plesk
# Pasa a "capacity" cuando GET /api/admin/plesk-check confirme las credenciales.
PROVISION_FALLBACK_MODE=manual
# Frases extra (separadas por coma) que cuentan como "reseller lleno", para
# ajustar el detector al mensaje real de tu WHM sin cambiar código.
PROVISION_CAPACITY_PATTERNS=

# ── Correo transaccional: ZeptoMail ──────────────────────────
# Con esto salen las credenciales al cliente, los avisos de renovación y las
# alertas al equipo. Token de ZeptoMail → Mail Agents → SMTP/API ("Zoho-enczapikey ...").
ZEPTOMAIL_TOKEN=
# Opcional. Default: https://api.zeptomail.com/v1.1/email (usa el .eu si tu
# cuenta está en ese datacenter).
ZEPTOMAIL_API_URL=
# Remitente. La dirección debe estar verificada en ZeptoMail.
MAIL_FROM_ADDRESS=
# Opcional. Default: Geniorama
MAIL_FROM_NAME=
# Opcional. Copia oculta de los correos al cliente. Varios separados por coma.
MAIL_BCC=
# A dónde llegan las alertas internas (fallo de aprovisionamiento, orden de
# suspensión, etc.). Si está vacío usa MAIL_BCC y, si tampoco hay, soporte@geniorama.site.
MAIL_OPS_ALERT=

# ── Integración con Geniorama Tickets ────────────────────────
# Al aprovisionar, el pedido se sincroniza contra
# <TICKETS_API_URL>/api/integrations/hosting-provisioned. Si faltan estas dos,
# la sincronización se salta sin romper el pedido.
TICKETS_API_URL=
# OJO: este valor debe ser IDÉNTICO al INTEGRATION_HOSTING_TOKEN configurado en
# el proyecto de tickets, o la llamada responde 401.
TICKETS_INTEGRATION_TOKEN=

# ── Trello: tarjeta de facturación ───────────────────────────
# Cada pedido pagado crea una tarjeta para que contabilidad emita la factura.
# Sin las tres primeras la creación se salta y solo queda el log.
# Key y token: https://trello.com/power-ups/admin → API key → Token.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
# Id de la lista destino (abre la tarjeta y agrega .json a la URL).
TRELLO_LIST_ID=
# Opcionales, separados por coma. Las etiquetas se suman a la que ya trae el código.
TRELLO_LABEL_IDS=
TRELLO_MEMBER_IDS=
# Días para la fecha de vencimiento de la tarjeta. Default: 3
TRELLO_INVOICE_DUE_DAYS=

# ── Renovaciones ─────────────────────────────────────────────
# El barrido diario manda los avisos de vencimiento y la orden de suspensión al
# equipo. Lo dispara la Scheduled Function de Netlify
# (netlify/functions/renewals-cron.mts), que llama a /api/cron/renewals.
#
# Días antes del vencimiento en que se avisa al cliente. Se manda una sola vez
# por ventana; el cron es idempotente.
RENEWAL_REMINDER_DAYS=30,15,5
# Días de gracia después del vencimiento antes de pedirle al equipo suspender.
RENEWAL_GRACE_DAYS=5
# Máximo de avisos por corrida. Netlify limita la duración de las funciones y
# cada aviso es un correo; si el barrido corta, lo dice con truncated:true y el
# resto sale en la siguiente corrida.
RENEWAL_SWEEP_LIMIT=25
# Token con el que la Scheduled Function llama al endpoint del barrido.
# Si no lo defines, el endpoint también acepta RESCUE_SECRET.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Admin rescue ─────────────────────────────────────────────
# Bearer token de los tres endpoints admin:
#   POST /api/admin/rescue-order    → reintenta el aprovisionamiento de un pedido
#                                     pagado que nunca se provisionó
#   POST /api/admin/complete-order  → termina los pasos posteriores de una cuenta
#                                     creada a mano en otro reseller
#   GET  /api/admin/plesk-check     → diagnostica la conexión con el reseller Plesk
# Generate with: openssl rand -hex 32
RESCUE_SECRET=
